# Optional: real exchange-rate API. "{base}" is replaced with the base currency code (COP, USD, EUR, GBP).
# Responses must contain `rates` or `conversion_rates` keyed by currency code.
# Example (free, no key): https://open.er-api.com/v6/latest/{base}
# Leave empty to use clearly-labelled demo rates.
VITE_EXCHANGE_RATE_API_URL=
